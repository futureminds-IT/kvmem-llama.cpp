+            // retrieval/generation caches, the multimodal checkpoints and the
+            // recurrent carries through llama_get_memory(), so nothing stale can
+            // be replayed into the rebuilt context after a wake.
+            if (lane->ctx) llama_driver_clear(*lane);
+            lane->active_prompt.reset();
+            lane->mm_rollback_prompt.reset();
